  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7A1C5F3E-2B44-4E6A-9D11-8C2E5B7A9301}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>LiteView</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- 显式声明工具集：不写时 MSBuild 会回退到 v100（VS2010）并报 MSB8020，
         导致命令行 build_msvc.bat 失败；VS2026 = v145，VS2022 打开时按提示
         重定向到 v143 即可（IDE 会自动改写这四行）。 -->
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;UNICODE;_UNICODE;NOMINMAX;_WIN32_WINNT=0x0601;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>user32.lib;gdi32.lib;shell32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <!-- 高 DPI 清单通过“附加清单文件”合并进链接器生成的清单：
           只保留一条嵌入路径，避免 CVT1100“资源重复(MANIFEST)”+ LNK1123 -->
      <AdditionalManifestFiles>$(ProjectDir)res\LiteView.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
    <PostBuildEvent>
      <!-- 语言包已内嵌进 exe（src\lang_packs_generated.cpp），因此不再需要随附
           lang\ 目录。这里只在 lang\ 存在时把它复制过去，作为“可覆盖内嵌译文”
           的外置副本，方便不重新编译就替换译文；缺失时不影响构建。 -->
      <Command>if exist "$(ProjectDir)lang\*.csv" (
  if not exist "$(OutDir)lang" mkdir "$(OutDir)lang"
  xcopy /Y /I /Q "$(ProjectDir)lang\*.csv" "$(OutDir)lang" &gt;nul 2&gt;nul
)
exit /b 0</Command>
    </PostBuildEvent>
    <ResourceCompile>
      <PreprocessorDefinitions>UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\i18n.cpp" />
    <ClCompile Include="src\lang_packs_generated.cpp" Condition="Exists('$(MSBuildProjectDirectory)\src\lang_packs_generated.cpp')">
      <!-- 由 tools/embed_lang.py 从 lang\*.csv 生成（已随仓库提交，克隆即可构建）。
           改过语言包后重新生成：python tools\embed_lang.py -->
      <ObjectFileName>$(IntDir)lang_packs_generated.obj</ObjectFileName>
    </ClCompile>
    <!-- 生成文件缺失时（没有 Python / 没有 lang\*.csv）用占位实现，保证仍可编译 -->
    <ClCompile Include="src\lang_packs_stub.cpp" Condition="!Exists('$(MSBuildProjectDirectory)\src\lang_packs_generated.cpp')" />
    <ClCompile Include="src\viewer.cpp" />
    <ClCompile Include="src\toolbar.cpp" />
    <ClCompile Include="src\panels.cpp" />
    <ClCompile Include="src\render.cpp" />
    <ClCompile Include="src\settings.cpp" />
    <ClCompile Include="src\assoc.cpp" />
    <ClCompile Include="src\util.cpp" />
    <ClCompile Include="src\image.cpp" />
    <ClCompile Include="src\inflate.cpp" />
    <ClCompile Include="src\codec.cpp" />
    <ClCompile Include="src\codec_bmp.cpp" />
    <ClCompile Include="src\codec_png.cpp" />
    <ClCompile Include="src\codec_jpeg.cpp" />
    <ClCompile Include="src\codec_gif.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\common.h" />
    <ClInclude Include="src\image.h" />
    <ClInclude Include="src\util.h" />
    <ClInclude Include="src\inflate.h" />
    <ClInclude Include="src\codec.h" />
    <ClInclude Include="src\render.h" />
    <ClInclude Include="src\settings.h" />
    <ClInclude Include="src\assoc.h" />
    <ClInclude Include="src\viewer.h" />
    <ClInclude Include="src\resource.h" />
    <ClInclude Include="src\i18n.h" />
    <ClInclude Include="src\i18n_embedded.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="LiteView.rc" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="res\app.ico" />
    <None Include="res\LiteView.manifest" />
    <None Include="README.md" />
    <None Include="build_msvc.bat" />
    <None Include="build_mingw.bat" />
    <None Include="build_mingw.sh" />
    <None Include="README.zh-CN.md" />
    <None Include="lang\zh-CN.csv" />
    <None Include="lang\ja-JP.csv" />
    <None Include="lang\template.csv" />
    <None Include="lang\README.md" />
    <None Include="tools\embed_lang.py" />
    <None Include="docs\development.md" />
    <None Include="docs\git-proxy.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
